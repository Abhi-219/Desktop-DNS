<Window x:Class="FamilyDnsLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family DNS Lock" Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundLightBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Family DNS Lock" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Parental DNS filtering and timed lock for Windows" FontSize="12" Foreground="#CBD5E1" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#334155" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="Connecting..." FontWeight="Bold" Foreground="White" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <!-- Alert Bar (warnings / service errors) -->
        <Border Grid.Row="1" x:Name="AlertBar" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ " Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="AlertText" Text="Service warning message" Foreground="#991B1B" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="16" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="Dashboard" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- Protection Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Current Protection Status" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Separator Margin="0,10,0,14" Background="{StaticResource BorderBrush}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="State:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TxtCurrentStatus" Text="Inactive" FontWeight="Bold" FontSize="14" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active DNS Provider:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TxtCurrentProvider" Text="CleanBrowsing Family Filter" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,12" x:Name="RowRemainingTime">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time Remaining:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TxtRemainingTime" Text="No active lock" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentGreenBrush}" />
                                </Grid>

                                <Grid Margin="0,0,0,12" x:Name="RowLockWindow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock Expiry Time:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TxtExpiresTime" Text="-" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Expiry Action:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" x:Name="TxtExpiryAction" Text="Keep Filtered DNS" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Actions Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Lock Controls" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Separator Margin="0,10,0,14" Background="{StaticResource BorderBrush}" />

                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="BtnGoToActivate" Content="Activate New Timed Lock" Margin="0,0,12,8" Click="BtnGoToActivate_Click" />
                                    <Button x:Name="BtnEarlyUnlock" Content="Unlock Early (Parent PIN)" Style="{StaticResource DangerButton}" Margin="0,0,12,8" Click="BtnEarlyUnlock_Click" Visibility="Collapsed" />
                                    <Button Content="Refresh Status" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" Click="BtnRefreshStatus_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: ACTIVATE LOCK -->
            <TabItem Header="Activate Lock" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="1. Choose Protection Duration" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Select how long the adult-content filtering should remain strictly locked on this computer." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                                <WrapPanel Margin="0,4,0,16">
                                    <RadioButton x:Name="Rb1Day" Content="1 Day" Margin="0,0,16,8" IsChecked="True" />
                                    <RadioButton x:Name="Rb7Days" Content="7 Days" Margin="0,0,16,8" />
                                    <RadioButton x:Name="Rb15Days" Content="15 Days" Margin="0,0,16,8" />
                                    <RadioButton x:Name="Rb30Days" Content="30 Days" Margin="0,0,16,8" />
                                    <RadioButton x:Name="Rb60Days" Content="60 Days" Margin="0,0,16,8" />
                                    <RadioButton x:Name="Rb90Days" Content="90 Days" Margin="0,0,16,8" />
                                    <RadioButton x:Name="RbCustom" Content="Custom Expiry" Margin="0,0,16,8" />
                                </WrapPanel>

                                <StackPanel x:Name="PanelCustomDuration" Orientation="Horizontal" Margin="0,0,0,16" Visibility="Collapsed">
                                    <TextBlock Text="Custom Expiry Date:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <DatePicker x:Name="DpCustomDate" Margin="0,0,10,0" />
                                    <TextBox x:Name="TxtCustomHours" Width="40" Text="12" Margin="0,0,4,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox x:Name="TxtCustomMinutes" Width="40" Text="00" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="(24h UTC/Local)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                </StackPanel>

                                <TextBlock Text="2. When Lock Expires" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0" />
                                <TextBlock Text="Choose what happens to the network DNS settings when the timed lock concludes." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10" />

                                <RadioButton x:Name="RbKeepFiltered" Content="Keep Filtered DNS active (Recommended - prevents accidental reversion to unfiltered access)" IsChecked="True" Margin="0,0,0,8" />
                                <RadioButton x:Name="RbRestorePrevious" Content="Restore Previous DNS addresses (Re-enables original dynamic DHCP or static addresses)" Margin="0,0,0,16" />

                                <TextBlock Text="3. Parent PIN Confirmation" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0" />
                                <TextBlock Text="Enter the parent PIN to confirm activating this lock." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="Parent PIN:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                    <PasswordBox x:Name="PbActivatePin" Width="180" MaxLength="16" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                                    <TextBlock x:Name="TxtActivatePinHint" Text="(No PIN set yet; you can set one in Settings)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                                    <TextBlock Text="Notice: Once activated, DNS settings are enforced across all physical Ethernet and Wi-Fi adapters. Outbound DNS bypasses (Port 853, direct unapproved Port 53) and browser Secure DNS will be locked. To release before expiry, the parent PIN is strictly required." TextWrapping="Wrap" FontSize="12" Foreground="#1E40AF" />
                                </Border>

                                <Button x:Name="BtnConfirmActivate" Content="Confirm &amp; Activate Protection Lock" HorizontalAlignment="Left" Padding="20,10" Click="BtnConfirmActivate_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: PARENT SETTINGS -->
            <TabItem Header="Parent Settings" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- PIN Setup Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Parent Access Control (PIN)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Set or change the parent PIN required to unlock early, change providers, or authorize uninstallation." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Current PIN:" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Column="1" x:Name="PbCurrentPin" MaxLength="16" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="New PIN (4-16 digits):" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Column="1" x:Name="PbNewPin" MaxLength="16" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Confirm New PIN:" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Column="1" x:Name="PbConfirmNewPin" MaxLength="16" />
                                </Grid>

                                <Button Content="Save Parent PIN" HorizontalAlignment="Left" Click="BtnSavePin_Click" />

                                <!-- Recovery Key Display Box -->
                                <Border x:Name="BoxRecoveryKey" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Emergency PIN Recovery Key:" FontWeight="Bold" Foreground="#15803D" />
                                        <TextBox x:Name="TxtRecoveryKeyDisplay" IsReadOnly="True" FontWeight="Bold" FontSize="14" Background="Transparent" BorderThickness="0" Margin="0,4,0,4" Foreground="#166534" />
                                        <TextBlock Text="Save this key in a secure location (e.g. password manager). If you ever forget your parent PIN, this key allows resetting it." FontSize="11" Foreground="#15803D" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PIN Recovery Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Forgot PIN? Recover with Recovery Key" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Enter your emergency recovery key (e.g. FDNS-XXXX-XXXX-XXXX) to reset your parent PIN." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recovery Key:" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="TxtInputRecoveryKey" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="New PIN:" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Column="1" x:Name="PbRecoverNewPin" MaxLength="16" />
                                </Grid>

                                <Button Content="Reset PIN via Recovery Key" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnRecoverPin_Click" />
                            </StackPanel>
                        </Border>

                        <!-- DNS Provider Configuration Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Configured Family DNS Provider" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="The DNS provider applied when a lock is activated. (Requires parent PIN if lock inactive)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14" />

                                <RadioButton x:Name="RbProviderCleanBrowsing" Content="CleanBrowsing Family Filter (Default: 185.228.168.168, 185.228.169.168, 2a0d:2a00:1::, 2a0d:2a00:2::)" IsChecked="True" Margin="0,0,0,10" />
                                <RadioButton x:Name="RbProviderCustom" Content="Custom Family DNS Provider" Margin="0,0,0,12" />

                                <StackPanel x:Name="PanelCustomProvider" Margin="20,0,0,14" Visibility="Collapsed">
                                    <TextBlock Text="Provider Name:" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtCustomProviderName" Margin="0,4,0,8" Width="300" HorizontalAlignment="Left" Text="Custom Filter" />

                                    <TextBlock Text="Server Addresses (Comma separated IPv4 &amp; IPv6):" FontSize="12" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtCustomProviderServers" Margin="0,4,0,8" Width="420" HorizontalAlignment="Left" Text="185.228.168.168, 2a0d:2a00:1::" />
                                    <TextBlock Text="Must contain at least one valid IPv4 address and one valid IPv6 address." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <Button Content="Save Provider Selection" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnSaveProvider_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: DIAGNOSTICS -->
            <TabItem Header="Diagnostics" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- Adapter Table Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Active Physical Network Adapters &amp; DNS Verification" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Live readback from Windows network stack (Get-DnsClientServerAddress)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                                <DataGrid x:Name="DgAdapters" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="100" BorderBrush="{StaticResource BorderBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Index" Binding="{Binding InterfaceIndex}" Width="60" />
                                        <DataGridTextColumn Header="Adapter Name" Binding="{Binding Name}" Width="180" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                        <DataGridTextColumn Header="Observed DNS Addresses" Binding="{Binding CurrentDnsSummary}" Width="*" />
                                        <DataGridTextColumn Header="Matches Filter?" Binding="{Binding MatchSummary}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Bypass Controls Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Bypass Protection Status" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Separator Margin="0,10,0,12" Background="{StaticResource BorderBrush}" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Windows Firewall Rules:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" x:Name="TxtDiagFirewall" Text="Active" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Browser DoH Policies:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" x:Name="TxtDiagBrowser" Text="Enforced (Edge, Chrome, Brave, Firefox)" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Log Tail Card -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Recent Service Log Entries" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBox x:Name="TxtServiceLogTail" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="140" Margin="0,10,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#F1F5F9" />
                                <Button Content="Reload Diagnostics" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnRefreshDiagnostics_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Early Unlock / PIN Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4" x:Name="ModalPinOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="380" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ModalTitle" Text="Parent Authorization Required" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ModalSubtitle" Text="Enter parent PIN to authorize this operation." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <TextBlock Text="Parent PIN:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PbModalPin" MaxLength="16" VerticalContentAlignment="Center" Padding="6" Margin="0,0,0,14" />

                    <TextBlock x:Name="ModalErrorText" Foreground="{StaticResource AccentRedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnModalCancel_Click" />
                        <Button x:Name="BtnModalConfirm" Content="Confirm" Click="BtnModalConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock Text="Family DNS Lock v1.0 • Designed for Windows 10/11" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="TxtLastUpdated" Text="Status: Connected" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
